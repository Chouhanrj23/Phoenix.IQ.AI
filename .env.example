# Phoenix local configuration. Copy to .env (gitignored) and set NEO4J_PASSWORD.
#
# Who reads this file:
#   - `docker compose` reads .env automatically (the local Neo4j in docker-compose.yml).
#   - The API does NOT read .env by itself. Start it with
#       cd apps/api && node --env-file=../../.env dist/index.js
#     or export these variables in its environment.
#   - The web app has its own file: apps/web/.env.example.
#
# Automated tests do not need this file: container-backed suites start their own
# throwaway Neo4j (Testcontainers). review-loop's live suite uses NEO4J_* when set.

# --- Neo4j (docker-compose.yml and the API) ---------------------------------------------------
# Safe to default (not secrets) -- Neo4j's own well-known local values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# REQUIRED. The API and graph-persistence have no default for a credential, and
# docker-compose.yml refuses to start until this is set.
NEO4J_PASSWORD=replace-with-a-real-local-password

# Optional connection bounds (milliseconds); defaults shown.
# NEO4J_CONNECTION_TIMEOUT_MS=5000
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT_MS=10000

# --- API (apps/api) -----------------------------------------------------------------------------
# PORT=3001
# HOST=0.0.0.0
# CORS_ORIGIN=http://localhost:3000

# Where sources, runs, run outputs and graph versions are stored (relative to the API's
# working directory; gitignored).
# PHOENIX_WORKSPACE_DIR=.phoenix-workspace

# Default tenant (systemId) for routes called without ?systemId=, and the tenant review
# decisions are stored under. Tenancy is data isolation only -- the API has no authentication.
# PHOENIX_SYSTEM_ID=aurora-commerce

# Allow file:// sources (the server reading its own filesystem). Development only.
# PHOENIX_ALLOW_LOCAL_SOURCES=false
