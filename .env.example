# Local development Neo4j instance (docker-compose.yml) -- Phase 4 prerequisite.
# Copy this file to .env (already gitignored) and fill in a real password.
#
# Consumed by: docker-compose.yml (to set the container's own credential)
# and, once P4-02/P4-07 wire it up, by @phoenix-ai/graph-persistence's
# loadNeo4jConfig() (packages/graph-persistence/src/config.ts) via the same
# variable names. Not used by automated tests -- those run against a real,
# ephemeral Testcontainers instance instead (see
# packages/graph-persistence/tests/neo4j-client.test.ts).

# Safe to default (not secrets) -- Neo4j's own well-known local values.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# REQUIRED. No default is provided anywhere in this repository -- a
# credential must never have a hardcoded fallback, even for local dev.
# docker-compose.yml will refuse to start until this is set.
NEO4J_PASSWORD=replace-with-a-real-local-password
