{
  "name": "@phoenix-ai/review-loop",
  "version": "0.1.0",
  "private": true,
  "description": "Captures and persists human corrections, prioritising high-leverage, low-confidence elements for reviewer attention.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b --watch",
    "lint": "eslint src",
    "typecheck": "tsgo -b --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@phoenix-ai/shared": "workspace:*",
    "@phoenix-ai/knowledge-graph": "workspace:*",
    "@phoenix-ai/graph-persistence": "workspace:*",
    "@phoenix-ai/reconciliation-engine": "workspace:*",
    "neo4j-driver": "^6.2.0",
    "@phoenix-ai/redaction-hardening": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
