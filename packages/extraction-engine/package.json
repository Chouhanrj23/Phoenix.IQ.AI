{
  "name": "@phoenix-ai/extraction-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Extracts exact facts from normalised artifacts using parsing, not model inference.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b --watch",
    "lint": "eslint src",
    "typecheck": "tsgo -b --noEmit",
    "test": "vitest run",
    "poc:analyze-phoenix": "tsx samples/analyze-phoenix-repo.ts",
    "poc:analyze-spring-petclinic": "tsx samples/analyze-spring-petclinic.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@phoenix-ai/shared": "workspace:*",
    "@phoenix-ai/ingestion-connectors": "workspace:*",
    "@phoenix-ai/knowledge-graph": "workspace:*",
    "java-parser": "3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
