{
  "name": "@phoenix-ai/okf-renderers",
  "version": "0.1.0",
  "private": true,
  "description": "Project the knowledge graph into the eleven OKF output artifact types. Renderers read the graph; they do not perform independent analysis.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b --watch",
    "lint": "eslint src",
    "typecheck": "tsgo -b --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@phoenix-ai/shared": "workspace:*",
    "@phoenix-ai/knowledge-graph": "workspace:*",
    "@phoenix-ai/review-loop": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
