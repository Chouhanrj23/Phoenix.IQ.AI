{
  "name": "@phoenix-ai/ingestion-connectors",
  "version": "0.1.0",
  "private": true,
  "description": "Connects to artifact sources (repos, wikis, ticketing, log stores, gateways) and normalises them into a common intermediate representation (CIR).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b --watch",
    "lint": "eslint src",
    "typecheck": "tsgo -b --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@phoenix-ai/knowledge-graph": "workspace:*",
    "@phoenix-ai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  }
}
