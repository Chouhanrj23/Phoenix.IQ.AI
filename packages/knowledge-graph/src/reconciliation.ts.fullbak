/**
 * P6-05 -- the Reconciliation model: the sixth domain-specific `kind`
 * vocabulary, alongside P2-03..06's four and P6-04's Work Item model, and
 * the FIRST to use `category: 'observation'` -- the structural category
 * P2-02 reserved from the start ("a meta-statement ABOUT other knowledge
 * objects... a review item surfacing a disputed value") but that no real
 * `kind` had filled until now. `tests/ui-coverage.test.ts` has documented
 * this exact gap since P2-12: "P2-02 already reserved the structural
 * category these would use (observation), unused by any real kind yet."
 * This file is what fills it.
 *
 * Implements the FRD's 3.6 "Reconciliation & Confidence Engine" module's
 * FR-REC-04/FR-REC-05: "When sources disagree, the system shall record a
 * conflict retaining both positions and their sources, and shall not
 * silently resolve it" / "Conflicts shall be exposed in outputs and
 * prioritised for review."
 *
 * Model only, exactly like every prior domain file: no claim comparison, no
 * confidence computation, no source-type weighting, no evidence aggregation
 * -- that is `packages/reconciliation-engine`'s job (`claim.ts`/
 * `reconcile.ts`/`confidence-scoring.ts`/`evidence-aggregation.ts`), the
 * same "model here, algorithm downstream" split P6-04 established between
 * this package's `workitem.ts` and `extraction-engine`'s `jira-bridge.ts`.
 * See `docs/architecture/adr/0029-p6-05-source-reconciliation.md`,
 * `docs/architecture/adr/0030-p6-06-confidence-calculation.md`, and
 * `docs/architecture/adr/0031-p6-08-evidence-aggregation.md`.
 */

import type { CanonicalKnowledgeObject } from './canonical-object.js';
import type { KnowledgeValue } from './identity.js';
import {
  isNonEmptyString,
  isPlainObject,
  validateCanonicalKnowledgeObject,
  type ValidationResult,
} from './validation.js';

// ---------------------------------------------------------------------------
// Object kinds
// ---------------------------------------------------------------------------

export const RECONCILIATION_OBJECT_KINDS = ['reconciliation.conflict'] as const;
export type ReconciliationObjectKind = (typeof RECONCILIATION_OBJECT_KINDS)[number];

// ---------------------------------------------------------------------------
// Typed attribute bag
// ---------------------------------------------------------------------------

/** One source's contribution to one disputed position -- WHO claimed it, and how authoritative that source was for this kind of claim (`reconciliation-engine`'s `authorityOf`). */
export interface ConflictPositionSource {
  [key: string]: KnowledgeValue;
  sourceId: string;
  /** `@phoenix-ai/shared`'s `SourceType`, kept as a plain string here so this model package does not depend on `reconciliation-engine`'s weighting logic -- only the raw fact of which source said what. */
  sourceType: string;
  /** The source-type authority score `reconciliation-engine` computed for this claim, 1 (weak) to 3 (authoritative). Recorded, not recomputed, so a reader does not need the weighting table to see why one position outranks another. */
  authority: number;
}

/**
 * Structurally mirrors `@phoenix-ai/shared`'s `Confidence`, narrowed to
 * `level: string` (rather than the closed `ConfidenceLevel` union) and given
 * its own index signature -- the same "loosened to satisfy `KnowledgeValue`"
 * move `ConflictPositionSource.sourceType` already makes for `SourceType`,
 * for the identical reason: a real `Confidence` cannot be assigned into an
 * indexed `KnowledgeValue` bag without an index signature of its own.
 */
export interface ConflictPositionConfidence {
  [key: string]: KnowledgeValue;
  level: string;
  score?: number;
  rationale?: string;
}

/**
 * ONE of the (at least two) mutually exclusive values sources disagreed on
 * for the same subject/attribute -- "a position", in FR-REC-04's own words.
 * Every position that had at least one source is retained; none is dropped
 * in favour of another, which is the whole point of this model existing.
 */
export interface ConflictPosition {
  [key: string]: KnowledgeValue;
  value: KnowledgeValue;
  /** Every source that claimed THIS value, most-authoritative first. */
  sources: ConflictPositionSource[];
  /**
   * How confident this SPECIFIC position is, given its own supporting
   * sources weighed against every OTHER position's contradicting ones --
   * `reconciliation-engine`'s `computeConfidence` (P6-06). Optional: a
   * conflict object built without it (e.g. a hand-authored fixture, or an
   * older caller) remains valid -- see `validateConflictObject`. Distinct
   * from the conflict object's own `metadata.confidence`, which is always
   * high (the conflict's EXISTENCE is directly observed) and says nothing
   * about which position is more likely correct.
   */
  confidence?: ConflictPositionConfidence;
  /**
   * Which entries of the conflict object's OWN `evidence` array (P6-08)
   * specifically back THIS position -- a set of `Evidence.id` references,
   * not a nested copy. Referencing by id (rather than embedding a second
   * copy of each `Evidence`) keeps the object's `evidence` array the single
   * source of truth: every id here is guaranteed present there, since both
   * are built from the same deduplicated aggregate
   * (`reconciliation-engine`'s `evidenceForClaims`). Optional, the same
   * backward-compatibility reasoning as `confidence` above.
   */
  evidenceIds?: string[];
}

export interface ConflictAttributes {
  [key: string]: KnowledgeValue;
  /** The correlation key identifying the real-world thing under dispute -- not necessarily a canonical object id; see ADR 0029 decision 1. */
  subjectId: string;
  /** Which attribute of that subject the sources disagree about, e.g. "status". */
  attribute: string;
  /** FR-REC-01's claim category (`structure`/`behaviour`/`deployment`/`intent`) this dispute was weighed under. Open string for the same reason `kind` is -- this model package does not own that closed vocabulary. */
  claimCategory: string;
  /** At least two entries -- see `validateConflictObject`. Never resolved to one; that is what "retain both positions" means. */
  positions: ConflictPosition[];
}

// ---------------------------------------------------------------------------
// Typed object
// ---------------------------------------------------------------------------

export interface ConflictObject extends CanonicalKnowledgeObject<ConflictAttributes> {
  category: 'observation';
  kind: 'reconciliation.conflict';
}

// ---------------------------------------------------------------------------
// Validation
// ---------------------------------------------------------------------------

function validatePositions(candidate: unknown): string[] {
  if (!Array.isArray(candidate)) {
    return ['attributes.positions must be an array'];
  }
  if (candidate.length < 2) {
    return [
      'attributes.positions must contain at least two entries -- a conflict with fewer than two positions is not a conflict',
    ];
  }

  const errors: string[] = [];
  candidate.forEach((position, index) => {
    if (!isPlainObject(position)) {
      errors.push(`attributes.positions[${index}] must be an object`);
      return;
    }
    if (!('value' in position)) {
      errors.push(`attributes.positions[${index}].value is required`);
    }
    const sources = position.sources;
    if (!Array.isArray(sources) || sources.length === 0) {
      errors.push(`attributes.positions[${index}].sources must be a non-empty array`);
      return;
    }
    sources.forEach((source, sourceIndex) => {
      if (!isPlainObject(source)) {
        errors.push(`attributes.positions[${index}].sources[${sourceIndex}] must be an object`);
        return;
      }
      if (!isNonEmptyString(source.sourceId)) {
        errors.push(`attributes.positions[${index}].sources[${sourceIndex}].sourceId is required`);
      }
      if (!isNonEmptyString(source.sourceType)) {
        errors.push(`attributes.positions[${index}].sources[${sourceIndex}].sourceType is required`);
      }
      if (typeof source.authority !== 'number') {
        errors.push(
          `attributes.positions[${index}].sources[${sourceIndex}].authority must be a number`,
        );
      }
    });

    if ('confidence' in position && position.confidence !== undefined) {
      const confidence = position.confidence;
      if (!isPlainObject(confidence) || !isNonEmptyString(confidence.level)) {
        errors.push(`attributes.positions[${index}].confidence.level is required when confidence is present`);
      } else if ('score' in confidence && confidence.score !== undefined && typeof confidence.score !== 'number') {
        errors.push(`attributes.positions[${index}].confidence.score, if present, must be a number`);
      }
    }

    if ('evidenceIds' in position && position.evidenceIds !== undefined) {
      const evidenceIds = position.evidenceIds;
      if (!Array.isArray(evidenceIds)) {
        errors.push(`attributes.positions[${index}].evidenceIds, if present, must be an array`);
      } else {
        evidenceIds.forEach((evidenceId, evidenceIndex) => {
          if (!isNonEmptyString(evidenceId)) {
            errors.push(
              `attributes.positions[${index}].evidenceIds[${evidenceIndex}] must be a non-empty string`,
            );
          }
        });
      }
    }
  });

  return errors;
}

/** Validates a Conflict object: identity + category "observation" + kind "reconciliation.conflict" + at least two retained positions. */
export function validateConflictObject(candidate: unknown): ValidationResult {
  const base = validateCanonicalKnowledgeObject(candidate);
  const errors = [...base.errors];

  if (isPlainObject(candidate)) {
    if (candidate.category !== 'observation') {
      errors.push('category must be "observation" for a conflict object');
    }
    if (candidate.kind !== 'reconciliation.conflict') {
      errors.push('kind must be "reconciliation.conflict"');
    }
    if (isPlainObject(candidate.attributes)) {
      if (!isNonEmptyString(candidate.attributes.subjectId)) {
        errors.push('attributes.subjectId is required');
      }
      if (!isNonEmptyString(candidate.attributes.attribute)) {
        errors.push('attributes.attribute is required');
      }
      if (!isNonEmptyString(candidate.attributes.claimCategory)) {
        errors.push('attributes.claimCategory is required');
      }
      errors.push(...validatePositions(candidate.attributes.positions));
    }
  }

  return { valid: errors.length === 0, errors };
}
