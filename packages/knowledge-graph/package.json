{
  "name": "@phoenix-ai/knowledge-graph",
  "version": "0.1.0",
  "private": true,
  "description": "The single source of truth from which all OKF outputs are projected; stores every element with provenance.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsgo -b",
    "dev": "tsgo -b --watch",
    "lint": "eslint src",
    "typecheck": "tsgo -b --noEmit",
    "test": "vitest run",
    "generate:sample": "tsx samples/generate-sample.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@phoenix-ai/shared": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
